@Library('Shared') _

pipeline {

    agent any

    stages {

        stage("Hello") {
            steps {
                script {
                    hello()
                }
            }
        }

        stage("Clone") {
            steps {
                script {
                    Clone(
                        'https://github.com/Sameer-Infra/Flask-Docker-K8s-project.git',
                        'main'
                    )
                }
            }
        }

        stage("Build") {
            steps {
                script {
                    docker_build(
                        "notes-app",
                        "latest",
                        "techwithsameer"
                    )
                }
            }
        }

        stage("Push To DockerHub") {
            steps {
                script {
                    docker_push(
                        "notes-app",
                        "latest",
                        "techwithsameer"
                    )
                }
            }
        }

        stage("Deploy") {
            steps {
                script {
                    docker_compose()
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline SUCCESS 🚀"
        }

        failure {
            echo "Pipeline FAILED ❌"
        }
    }
}
